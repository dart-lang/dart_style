40 columns                              |
(trailing_commas preserve)
>>> Forces split with trailing comma.
enum E {e,}
<<< 3.7
enum E {
  e,
}
>>> Doesn't force split without trailing comma.
enum E {e,f,g}
<<< 3.7
enum E { e, f, g }
>>> May still split without trailing comma if doesn't fit.
enum E { value1, value2, value3, value4 }
<<< 3.7
enum E {
  value1,
  value2,
  value3,
  value4,
}
>>> Preserve trailing comma but remove semicolon if no members.
enum E {e,;}
<<< 3.7
enum E {
  e,
}
>>> No trailing comma with members keeps semicolon on same line.
enum E { a, b, c; int x; }
<<< 3.9
enum E {
  a,
  b,
  c;

  int x;
}
>>> Trailing comma with members.
enum E { a, b, c,; int x; }
<<< 3.9 Remove the trailing comma so the semicolon isn't on its own line.
enum E {
  a,
  b,
  c;

  int x;
}
<<< 3.10 Preserve the trailing comma because that's the user intent.
enum E {
  a,
  b,
  c,
  ;

  int x;
}
>>> Force split in enum value argument list with trailing comma.
enum Args {
value(a,b,),
another(named:1,)
}
<<< 3.7
enum Args {
  value(
    a,
    b,
  ),
  another(
    named: 1,
  ),
}
>>> Splits even without trailing comma because of the primary constructor.
enum E() {e,f,g}
<<< 3.13
enum E() {
  e,
  f,
  g,
}
>>> Preserve trailing comma but remove semicolon if primary constructor and no members.
enum E() {e,;}
<<< 3.13
enum E() {
  e,
}
>>> No trailing comma with primary constructor and members keeps semicolon on same line.
enum E() { a, b, c; int x; }
<<< 3.13
enum E() {
  a,
  b,
  c;

  int x;
}
>>> Trailing comma with primary constructor and members.
enum E() { a, b, c,; int x; }
<<< 3.13
enum E() {
  a,
  b,
  c,
  ;

  int x;
}
